{
  "package": ".",
  "versionVariable": "github.com/castrowithcee/qatlas-host/internal/cli.version",
  "targets": ["linux/amd64", "linux/arm64"],
  "manpageCommand": ["go", "run", ".", "manpage", "--dir", "{dir}"],
  "files": [
    {"source": "packaging/qhost-deploy.service", "path": "lib/systemd/system/qhost-deploy.service"},
    {"source": "packaging/update.json", "path": "share/qhost/update.json"}
  ],
  "installer": {
    "displayName": "Qatlas Host",
    "nextStep": "Next: sign in again, then run qhost; a change needs sudo qhost."
  },
  "service": {
    "unit": "packaging/qhost.service",
    "groups": [],
    "addInstallingUser": true,
    "writableConfig": false
  }
}
